---
import { href, type PageId } from '../lib/site';
interface Props { page: PageId; }
const { page } = Astro.props;
const items: [string, PageId][] = [['大会ルール', 'PG-005'], ['スケジュール', 'PG-009'], ['参加者', 'PG-010'], ['大会当日', 'PG-014']];
---
<nav aria-label="共通メニュー"><ul class="menu">{items.map(([label, to]) => <li><a class="text-link" href={href(page, to)}>{label}</a></li>)}</ul></nav>
