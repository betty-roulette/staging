---
import Page from '../../../../layouts/Page.astro';
import ReferencedImage from '../../../../components/ReferencedImage.astro';
import { href, type ImageId, type PageId } from '../../../../lib/site';

const page = 'PG-018';
const cards: { name: string; image: ImageId; to: PageId }[] = [
  { name: '参加者紹介', image: 'IMG-014', to: 'PG-012' },
  { name: '対戦・トーナメント表', image: 'IMG-015', to: 'PG-013' },
  { name: '配信情報', image: 'IMG-017', to: 'PG-016' },
];
---
<Page page={page}>
  <h1>大会途中の試合結果・進行状況</h1>
  <h2>試合結果速報</h2>
  <div class="slides-outer">
    <div class="slides-inner">
      <iframe
        class="results-slide"
        src="https://docs.google.com/presentation/d/e/2PACX-1vS84pRgnA6LhIgqnm6y8cwZSyMTHA8ag61bHB1v3VDO7e6qkiOjh4uID-G4r0VGULvKeAIIrSih0mJS/pubembed?start=true&amp;loop=false&amp;delayms=60000"
        frameborder="0"
        width="960"
        height="569"
        allowfullscreen="true"
        mozallowfullscreen="true"
        webkitallowfullscreen="true"
        title="試合結果速報"
      ></iframe>
    </div>
  </div>
  <h2>勝敗・トーナメント表</h2>
  <div class="slides-outer">
    <div class="slides-inner">
      <iframe
        class="bracket-slide"
        src="https://docs.google.com/presentation/d/e/2PACX-1vQLMlKJRQPpwHUTT8msvOKTvqJXQA9qMHjHZtmAwr7dIQhwI3G4lYbSPfB15vlEd0HOe8PuJZ7umMcq/pubembed?start=true&amp;loop=false&amp;delayms=60000"
        frameborder="0"
        width="800"
        height="669"
        allowfullscreen="true"
        mozallowfullscreen="true"
        webkitallowfullscreen="true"
        title="勝敗・トーナメント表"
      ></iframe>
    </div>
  </div>
  <div class="image-links progress-cards">
    {cards.map(({ name, image, to }) => (
      <a class="image-card" href={href(page, to)}>
        <span class="image-stage"><ReferencedImage id={image} /></span>
        <span class="image-label"><span>{name}</span><span class="arrow" aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
  <p class="parent-link"><a class="text-link" href={href(page, 'PG-014')}>大会当日 へ戻る</a></p>
</Page>

<style>
  h1 { margin-bottom: 20px; }
  h2 { margin: 0 0 16px; }
  .slides-outer + h2 { margin-top: 20px; }
  .slides-outer, .slides-inner {
    box-sizing: border-box;
    width: 100%;
    border: 1px solid #007F83;
    border-radius: 10px;
  }
  .slides-outer { padding: 16px; background: #EBF8FB; }
  .slides-inner { padding: 0; background: #FFFFFF; }
  iframe {
    display: block;
    width: 100%;
    height: auto;
    margin-inline: auto;
    border: 0;
  }
  .results-slide { max-width: 960px; aspect-ratio: 960 / 569; }
  .bracket-slide { max-width: 800px; aspect-ratio: 800 / 669; }
  .progress-cards { margin-top: 32px; }
  .image-card { background: #FFFFFF; }
  .image-stage { display: flex; align-items: center; }
  :global(.pg018 .progress-cards .image-stage img) {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  @media (max-width: 960px) {
    h1 { margin-bottom: 18px; }
    h2 { margin-bottom: 12px; }
    .slides-outer + h2 { margin-top: 16px; }
    .slides-outer { padding: 12px; }
    .progress-cards { margin-top: 16px; }
  }
</style>
