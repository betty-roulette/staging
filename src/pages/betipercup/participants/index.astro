---
import Page from '../../../layouts/Page.astro';
import Info from '../../../components/Info.astro';
import ReferencedImage from '../../../components/ReferencedImage.astro';
import { href, type ImageId } from '../../../lib/site';

const page = 'PG-010';
const cards: { name: string; heading?: string; image: ImageId; enabled: boolean; description: [string, string] }[] = [
  {
    name: '募集要項', image: 'IMG-010', enabled: true,
    description: [
      '大会への参加を希望される方に向けて、応募条件や参加方法などをご案内しています。',
      'チーム・個人それぞれの参加申込フォームもご用意しています。',
    ],
  },
  {
    name: '参加者紹介', image: 'IMG-014', enabled: false,
    description: [
      '大会に参加するチームやメンバーをご紹介しています。',
      '各チームの意気込みや参加者の情報などをご覧いただけます。',
    ],
  },
  {
    name: '対戦表', heading: '対戦・トーナメント表', image: 'IMG-015', enabled: false,
    description: [
      '大会に参加するチーム同士の対戦組み合わせ（トーナメント表）をご案内しています。',
      '試合の対戦順や大会の進行状況などをご確認いただけます。',
    ],
  },
];
---
<Page page={page}>
  <h1>参加者</h1>
  {cards.map(({ name, heading = name, image, enabled, description }) => {
    const Card = enabled ? 'a' : 'div';
    return (
      <Info title={heading}>
        <Card class:list={['participant-card', { 'is-disabled': !enabled }]} href={enabled ? href(page, 'PG-011') : undefined}>
          <span class="participant-image"><ReferencedImage id={image} class="full-image" /></span>
          <span class="participant-details">
            <span class="participant-label">
              <span>{name}</span>
              {enabled && <span class="arrow participant-arrow" aria-hidden="true">→</span>}
            </span>
            <span>{description[0]}<br />{description[1]}</span>
          </span>
        </Card>
      </Info>
    );
  })}
</Page>

<style>
  h1 { margin-bottom: 20px; }
  :global(.pg010 .info) { border-radius: 10px; }
  :global(.pg010 .info > h2) { margin-bottom: 16px; }
  .participant-card {
    display: grid;
    grid-template-columns: minmax(0, 33fr) minmax(0, 67fr);
    align-items: center;
    width: 100%;
    gap: 16px;
    padding: 16px;
    border: 3px solid #00A1BF;
    border-radius: 10px;
    background: #EBF8FB;
    color: inherit;
    text-decoration: none;
  }
  .participant-card.is-disabled { background: #EDF1F2; }
  .participant-image {
    background: #EBF8FB;
    border: 1px solid #00A1BF;
    border-radius: 10px;
    overflow: hidden;
  }
  .participant-details {
    align-self: stretch;
    display: grid;
    align-content: center;
    gap: 8px;
    padding: 12px;
    background: #FFFFFF;
  }
  .participant-label { display: flex; align-items: center; justify-content: space-between; }
  .participant-arrow { background: #FFFFFF; }
  @media (max-width: 960px) {
    h1 { margin-bottom: 18px; }
    :global(.pg010 .info > h2) { margin-bottom: 12px; }
    .participant-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      padding: 12px;
      border-width: 2px;
    }
    .participant-arrow { background: none; }
  }
</style>
