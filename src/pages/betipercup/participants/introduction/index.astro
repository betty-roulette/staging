---
import Page from '../../../../layouts/Page.astro';
import ReferencedImage from '../../../../components/ReferencedImage.astro';
import { href, type ImageId } from '../../../../lib/site';

const page = 'PG-012';
const teams = [
  { name: 'チームA', message: '優勝を目指して、チーム一丸となって全力で挑みます！' },
  { name: 'チームB', message: '仲間との連携を大切に、最後まで諦めずに戦います！' },
];
const participants = [
  { name: '参加者1', socials: ['X', 'Twitch'] },
  { name: '参加者2', socials: ['X'] },
  { name: '参加者3', socials: [] },
  { name: '参加者4', socials: ['X'] },
  { name: '参加者5', socials: ['X', 'Twitch'] },
];
const cards: { name: string; image: ImageId }[] = [
  { name: '対戦・トーナメント表', image: 'IMG-015' },
  { name: '配信情報', image: 'IMG-017' },
  { name: '試合結果・進行状況', image: 'IMG-019' },
];
---
<Page page={page}>
  <h1>参加者紹介</h1>
  <div class="teams">
    {teams.map((team) => (
      <section class="team">
        <h2>{team.name}</h2>
        <div class="team-details">
          <span>意気込み</span>
          <p>{team.message}</p>
          <span>参加者</span>
          <ul class="participants">
            {participants.map(({ name, socials }) => (
              <li>
                <span class="participant-name">{name}</span>
                <span class="socials">{socials.map((social) => <span>{social}</span>)}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))}
  </div>
  <div class="image-links introduction-cards">
    {cards.map(({ name, image }) => (
      <div class="image-card">
        <span class="image-stage"><ReferencedImage id={image} /></span>
        <span class="image-label">{name}</span>
      </div>
    ))}
  </div>
  <p class="parent-link"><a class="text-link" href={href(page, 'PG-010')}>参加者へ戻る</a></p>
</Page>

<style>
  h1 { margin-bottom: 20px; }
  .teams { display: grid; gap: 20px; }
  .team {
    min-width: 0;
    padding: 16px;
    border: 1px solid #00A1BF;
    border-radius: 10px;
    background: #FFFFFF;
  }
  .team h2 {
    margin-top: 0;
    border-bottom: 1px solid #00A1BF;
    overflow-wrap: anywhere;
  }
  .team-details {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 16px;
    overflow-wrap: anywhere;
  }
  .team-details p, .participants { margin: 0; }
  .participants { display: grid; gap: 16px; padding: 0; list-style: none; }
  .participants li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 16px;
  }
  .socials { display: flex; flex-wrap: wrap; align-content: start; gap: 10px; }
  .introduction-cards { margin-top: 32px; }
  .image-card, .image-label { background: #EDF1F2; }
  .image-stage { display: flex; align-items: center; }
  :global(.pg012 .introduction-cards .image-stage img) {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  @media (max-width: 960px) {
    h1 { margin-bottom: 18px; }
    .teams { gap: 16px; }
    .team { padding: 14px; }
    .team-details { gap: 12px; }
    .participants, .participants li { gap: 12px; }
    .introduction-cards { margin-top: 16px; }
  }
</style>
