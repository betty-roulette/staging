---
import Page from '../../../../layouts/Page.astro';
import Info from '../../../../components/Info.astro';
import ReferencedImage from '../../../../components/ReferencedImage.astro';
import { href, type ImageId, type PageId } from '../../../../lib/site';

const page = 'PG-012';
const cards: { name: string; image: ImageId; to: PageId }[] = [
  { name: '対戦・トーナメント表', image: 'IMG-015', to: 'PG-013' },
  { name: '配信情報', image: 'IMG-017', to: 'PG-016' },
  { name: '試合結果・進行状況', image: 'IMG-019', to: 'PG-018' },
];
---
<Page page={page}>
  <h1>参加者紹介</h1>
  <Info class="participant-list">
    <h2>参加者リスト</h2>
    <hr />
    <ReferencedImage id="IMG-502" class="full-image" />
  </Info>
  <div class="image-links introduction-cards">
    {cards.map(({ name, image, to }) => (
      <a class="image-card" href={href(page, to)}>
        <span class="image-stage"><ReferencedImage id={image} /></span>
        <span class="image-label"><span>{name}</span><span class="arrow" aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
  <p class="parent-link"><a class="text-link" href={href(page, 'PG-010')}>参加者へ戻る</a></p>
</Page>

<style>
  h1 { margin-bottom: 20px; }
  :global(.pg012 .participant-list) { border-radius: 10px; }
  .participant-list h2 { margin: 0; }
  hr { margin: 10px 0; border: 0; border-top: 1px solid #00A1BF; }
  .introduction-cards { margin-top: 32px; }
  .image-card { background: #FFFFFF; }
  .image-stage { display: flex; align-items: center; }
  :global(.pg012 .introduction-cards .image-stage img) {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  @media (max-width: 960px) {
    h1 { margin-bottom: 18px; }
    .introduction-cards { margin-top: 16px; }
  }
</style>
