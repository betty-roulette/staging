---
import Page from '../../../../layouts/Page.astro';
import Info from '../../../../components/Info.astro';
import ImageCard from '../../../../components/ImageCard.astro';
import ReferencedImage from '../../../../components/ReferencedImage.astro';
import { href, type ImageId } from '../../../../lib/site';

const page = 'PG-013';
const disabledCards: { name: string; image: ImageId }[] = [
  { name: '配信情報', image: 'IMG-017' },
  { name: '試合結果・進行状況', image: 'IMG-019' },
];
---
<Page page={page}>
  <h1>対戦・トーナメント表</h1>
  <Info class="tournament">
    <h2>トーナメント表</h2>
    <hr />
    <ReferencedImage id="IMG-501" class="full-image" />
  </Info>
  <div class="image-links bracket-cards">
    <ImageCard page={page} to="PG-012" image="IMG-014" />
    {disabledCards.map(({ name, image }) => (
      <div class="image-card is-disabled">
        <span class="image-stage"><ReferencedImage id={image} /></span>
        <span class="image-label">{name}</span>
      </div>
    ))}
  </div>
  <p class="parent-link"><a class="text-link" href={href(page, 'PG-010')}>参加者 に戻る</a></p>
</Page>

<style>
  h1 { margin-bottom: 20px; }
  :global(.pg013 .tournament) { border-radius: 10px; }
  .tournament h2 { margin: 0; }
  hr { margin: 10px 0; border: 0; border-top: 1px solid #00A1BF; }
  .bracket-cards { margin-top: 32px; }
  .is-disabled, .is-disabled .image-label { background: #EDF1F2; }
  :global(.pg013 .bracket-cards .image-stage) { display: flex; align-items: center; }
  :global(.pg013 .bracket-cards .image-stage img) {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  @media (max-width: 960px) {
    h1 { margin-bottom: 18px; }
    .bracket-cards { margin-top: 16px; }
  }
</style>
