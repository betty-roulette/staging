---
import Page from '../../../../layouts/Page.astro';
import Info from '../../../../components/Info.astro';
import { href } from '../../../../lib/site';

const page = 'PG-011';
const formUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdFkS9jC6Zftel7-qMkA_b1yBlFTOUzWKtzt8BlTCuamK7r1w/viewform?embedded=true';
const rows = [
  ['応募単位', ['チーム単位で応募する']],
  ['チーム人数', ['4～5人']],
  ['募集チーム数', ['最小4チーム']],
  ['応募条件', ['18歳以上／BAN歴がないこと', 'Discord・Xを利用できること']],
  ['対応プラットフォーム', ['Steam／Epic Games／PlayStation']],
  ['募集期間', ['11月上旬～11月下旬（暫定）']],
  ['応募方法', ['ページ内のGoogleフォームから応募']],
  ['応募多数の場合', ['抽選で決定']],
  ['参加確定', ['対戦表発表時に参加確定']],
  ['連絡方法', ['Xのダイレクトメッセージで連絡']],
  ['欠員の扱い', ['チームに欠員が生じた場合、チーム側で補填する']],
  ['参加時の同意', ['大会ルール・注意事項／免責事項への同意', '名前の表示・配信での音声利用への同意']],
  ['個人情報の利用', ['本大会の主催者が開催する大会・イベントにのみ利用']],
  ['関連ページ', ['注意事項・免責事項', 'お問い合わせ・よくある質問']],
] as const;
---
<Page page={page}>
  <h1>募集要項</h1>
  <Info title="募集要項">
    <table class="rules-table recruitment-table">
      <colgroup><col /><col /></colgroup>
      <thead><tr><th scope="col">項目</th><th scope="col">内容</th></tr></thead>
      <tbody>
        {rows.map(([label, lines]) => (
          <tr>
            <th scope="row">{label}</th>
            <td>
              {label === '参加時の同意' ? (
                <><a class="text-link" href={href(page, 'PG-005')}>大会ルール</a>・<a class="text-link" href={href(page, 'PG-019')}>注意事項／免責事項</a>への同意<br />{lines[1]}</>
              ) : label === '関連ページ' ? (
                <><a class="text-link" href={href(page, 'PG-019')}>{lines[0]}</a><br /><a class="text-link" href={href(page, 'PG-021')}>{lines[1]}</a></>
              ) : lines.map((line, i) => <>{i > 0 && <br />}{line}</>)}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </Info>
  <Info title="募集">
    <div class="form-decoration">
      <div class="form-display">
        <iframe
          class="pg011__form-iframe"
          src={formUrl}
          title="参加申込フォーム"
          width="640"
          height="825"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
        >読み込んでいます…</iframe>
      </div>
    </div>
  </Info>
  <p class="parent-link"><a class="text-link" href={href(page, 'PG-010')}>参加者 に戻る</a></p>
</Page>

<style>
  h1 { margin-bottom: 20px; }
  :global(.pg011 .info) { border-radius: 10px; }
  :global(.pg011 .info > h2) { margin-bottom: 16px; }
  .recruitment-table col:first-child { width: 25%; }
  .recruitment-table col:last-child { width: 75%; }
  .recruitment-table tbody tr:nth-child(odd) > :is(th, td) { background: #FFFFFF; }
  .recruitment-table tbody tr:nth-child(even) > :is(th, td) { background: #F1F9FB; }
  .form-decoration, .form-display {
    box-sizing: border-box;
    border: 1px solid #00A1BF;
    border-radius: 10px;
  }
  .form-decoration { width: 100%; padding: 16px; background: #EBF8FB; }
  .form-display { width: 642px; max-width: 100%; margin-inline: auto; background: #FFFFFF; }
  .pg011__form-iframe { display: block; width: 640px; max-width: 100%; height: 825px; margin-inline: auto; border: 0; }
  @media (max-width: 960px) {
    h1 { margin-bottom: 18px; }
    :global(.pg011 .info > h2) { margin-bottom: 12px; }
    .recruitment-table col:first-child { width: 40%; }
    .recruitment-table col:last-child { width: 60%; }
    .form-decoration { padding: 12px; }
  }
</style>
