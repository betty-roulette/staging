---
import Page from '../../layouts/Page.astro';
import Info from '../../components/Info.astro';
import ReferencedImage from '../../components/ReferencedImage.astro';
import ImageCard from '../../components/ImageCard.astro';
import { href, pages, type PageId } from '../../lib/site';
const page = 'PG-002';
type NoticePart = string | { label: string; to: PageId };
const notices: { date: string; text: string | NoticePart[] }[] = [
  {
    date: '2026-11-08',
    text: [
      '2026/11/8　',
      { label: 'お問合せ・よくある質問', to: 'PG-021' },
      '、',
      { label: '注意事項・免責事項', to: 'PG-019' },
      '、',
      { label: 'プライバシー・権利情報', to: 'PG-022' },
      ' を更新しました',
    ],
  },
  { date: '2026-11-05', text: '2026/11/5　べちぱーCup Vol.1の大会公式サイトを公開しました。大会概要・大会ルール・スケジュールなどの情報をご案内しています。' },
];
const visibleNotices = [...notices].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 5);
const other: PageId[] = ['PG-021', 'PG-020', 'PG-019', 'PG-022'];
---
<Page page={page}>
  <section class="hero">
    <div class="main-image"><ReferencedImage id="IMG-002" /></div>
    <div class="hero-description"><p>大会情報</p><h1>べちぱーCup Vol.1</h1>
      <p>「べちぱーCup Vol.1」は、Dead by Daylightで開催する大会です。参加する方も、応援する方も、みんなで楽しめる大会を目指して開催します。</p>
      <p>このページでは、大会概要、ルール、スケジュール、参加者情報、大会当日の案内、大会結果など、べちぱーCup Vol.1に関する情報をまとめてご案内します。</p>
    </div>
  </section>
  <Info title="お知らせ" class="notice">
    {visibleNotices.map(({ text }) => (
      <p>{typeof text === 'string' ? text : text.map((part) => (
        typeof part === 'string' ? part : <a class="text-link" href={href(page, part.to)}>{part.label}</a>
      ))}</p>
    ))}
  </Info>
  <section class="guides"><h2>大会情報のご案内</h2><div class="image-links">
    <ImageCard page={page} to="PG-004" image="IMG-003" />
    <ImageCard page={page} to="PG-005" image="IMG-004" />
    <ImageCard page={page} to="PG-009" image="IMG-008" />
    <ImageCard page={page} to="PG-010" image="IMG-009" />
    <ImageCard page={page} to="PG-014" image="IMG-011" />
  </div></section>
  <section class="other-guides"><h2>その他のご案内</h2><div class="text-links">{other.map((to) => <a class="text-link" href={href(page, to)}>{pages[to][0]}</a>)}</div></section>
</Page>
