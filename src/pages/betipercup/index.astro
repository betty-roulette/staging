---
import Page from '../../layouts/Page.astro';
import Info from '../../components/Info.astro';
import ReferencedImage from '../../components/ReferencedImage.astro';
import ImageCard from '../../components/ImageCard.astro';
import { href, pages, type PageId } from '../../lib/site';
const page = 'PG-002';
type NoticePart = string | { label: string; to: PageId };
const notices: { date: string; text: string | NoticePart[] }[] = [
  {
    date: '2026-11-14',
    text: [{ label: 'キラー：ルール', to: 'PG-008' }, 'に禁止パークを記載しました'],
  },
  {
    date: '2026-11-11',
    text: [{ label: '協賛・賞金ページを追加しました', to: 'PG-024' }],
  },
  { date: '2026-11-09', text: 'Promotion Video(PV)を掲載しました。' },
  {
    date: '2026-11-08',
    text: [
      { label: 'お問合せ・よくある質問', to: 'PG-021' },
      '、',
      { label: '注意事項・免責事項', to: 'PG-019' },
      '、',
      { label: 'プライバシー・権利情報', to: 'PG-022' },
      ' を更新しました',
    ],
  },
  { date: '2026-11-05', text: 'べちぱーCup Vol.1の大会公式サイトを公開しました。大会概要・大会ルール・スケジュールなどの情報をご案内しています。' },
];
const visibleNotices = [...notices].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 5);
const other: PageId[] = ['PG-021', 'PG-019', 'PG-022'];
---
<Page page={page}>
  <section class="hero">
    <div class="main-image"><ReferencedImage id="IMG-002" /></div>
    <div class="hero-description"><h1>べちぱーCup Vol.1</h1>
      <p>「べちぱーCup Vol.1」は、Dead by Daylightで開催する大会です。参加する方も、応援する方も、みんなで楽しめる大会を目指して開催します。</p>
      <p>このページでは、大会概要、ルール、スケジュール、参加者情報、大会当日の案内、大会結果など、べちぱーCup Vol.1に関する情報をまとめてご案内します。</p>
    </div>
  </section>
  <iframe
    src="https://www.youtube.com/embed/nuPGM8GuxuE?si=9RxtjQyCp9z7FtqB"
    title="YouTube video player"
    loading="lazy"
    style="display: block; width: calc(100% * 2 / 3); height: auto; aspect-ratio: 16 / 9; margin-inline: auto; border: 0;"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
  ></iframe>
  <h2 class="notice-heading">お知らせ</h2>
  <Info class="notice">
    <table class="notice-table" aria-label="お知らせの日付と本文">
      <tbody>
        <tr>
          <td><strong>参加者募集中</strong></td>
          <td>参加者募集を開始しました。<a class="text-link" href={href(page, 'PG-011')}>募集要項</a>より申込ください。個人での参加申込も可能になりました。</td>
        </tr>
        {visibleNotices.map(({ date, text }) => (
          <tr>
            <td><time datetime={date}>{date.split('-').map(Number).join('/')}</time></td>
            <td>{typeof text === 'string' ? text : text.map((part) => (
              typeof part === 'string' ? part : <a class="text-link" href={href(page, part.to)}>{part.label}</a>
            ))}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </Info>
  <section class="guides"><h2>大会情報のご案内</h2><div class="image-links">
    <ImageCard page={page} to="PG-004" image="IMG-003" />
    <ImageCard page={page} to="PG-005" image="IMG-004" />
    <ImageCard page={page} to="PG-009" image="IMG-008" />
    <ImageCard page={page} to="PG-010" image="IMG-009" />
    <ImageCard page={page} to="PG-014" image="IMG-011" />
    <ImageCard page={page} to="PG-024" image="IMG-022" />
  </div></section>
  <section class="other-guides">
    <h2>その他のご案内</h2>
    <div class="text-links" style="grid-template-columns: repeat(3, minmax(0, 1fr)); overflow-wrap: anywhere;">
      {other.map((to) => <a href={href(page, to)}><span class="text-link">{pages[to][0]}</span></a>)}
      <span style="grid-area: 2 / 1; font-weight: bold;">大会運営：にくまんの会</span>
    </div>
  </section>
</Page>

<style is:global>
  .pg002 .hero + iframe { margin-top: 36px; }

  .pg002 .hero-description { align-self: start; }
  .pg002 .hero-description > h1 { margin-top: 0; }

  .pg002 .notice-heading,
  .pg002 .guides > h2,
  .pg002 .other-guides > h2 { margin-block: 36px 8px; }

  /* The notice's top border and padding each contribute 4px to the gap. */
  .pg002 .notice-heading { margin-bottom: 0; }
  .pg002 .notice { padding-top: 4px; }

  /* Include the card border in the gap to the image element. */
  .pg002 .guides > h2 { margin-bottom: 4px; }
  @media (max-width: 960px) {
    .pg002 .guides > h2 { margin-bottom: 7px; }
  }

  .pg002 .other-guides .text-links a {
    align-items: flex-start;
    text-decoration: none;
  }

  .pg002 .notice-table { border-collapse: collapse; font: inherit; }
  .pg002 .notice-table td { border: 0; padding: 0; vertical-align: top; }
  .pg002 .notice-table td:first-child { padding-inline-end: 1em; white-space: nowrap; }
  .pg002 .notice-table tr:not(:last-child) td { padding-bottom: 1em; }
</style>
